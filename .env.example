NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Solo servidor — lecturas operativas (no exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Opcional — versión reportada del bot en Estado del Sistema
NEXT_PUBLIC_BOT_VERSION=0.1.0

# Correos (separados por coma) que reciben rol SUPERADMIN al primer login
SUPERADMIN_EMAILS=admin@whatxia.com

# Opcional — secreto HMAC para tokens de reautenticación (default: service role)
REAUTH_SECRET=change-me-in-production
